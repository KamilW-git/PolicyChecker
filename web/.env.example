# PostgreSQL — lokalnie (bez Dockera):
DATABASE_URL="postgresql://policyuser:policypassword@localhost:5432/policychecker?schema=public"

# PostgreSQL — w Docker Compose (host `db` jest ustawiony w docker-compose.yml):
# DATABASE_URL="postgresql://policyuser:policypassword@db:5432/policychecker?schema=public"

# JWT secret for session cookies — required in production
JWT_SECRET="change-me-to-a-long-random-string"

NODE_ENV="development"
